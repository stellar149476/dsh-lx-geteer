{
  "name": "dsh-lx-geteer",
  "version": "0.4.6",
  "private": true,
  "type": "module",
  "description": "在 Harness 对话中点歌或用 .lxmc 歌单播放；支持音质/音源按钮（默认 320K/网易云）、右侧播放器、单曲/列表/随机/顺序模式。",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/",
    "README.md",
    "THIRD-PARTY.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  }
}
